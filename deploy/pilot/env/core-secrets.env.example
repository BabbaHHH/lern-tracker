# Fill only in a separately authorized setup, outside the release, root:root 0600.
# URI-encode user/password. Explicit port, no URI query. Loopback DB only here.
DATABASE_URL=postgresql://__DB_USER__:__DB_PASSWORD_URIENCODED__@127.0.0.1:5432/__DB_NAME__
BETTER_AUTH_SECRET=__AUTH_SECRET_BASE64URL_43_TO_128__
STEX_AUTH_MAIL_KEY=__DISTINCT_MAIL_KEY_BASE64URL_43_TO_128__
