# Explicitly required by the current production backup/restore CLI, even without AI use.
# Separate backup protection and two unrelated 32-byte hex credential secrets.
# No secret generation, local-file fallback, or AI activation is provided here.
STEX_AUTH_BACKUP_KEY=__DISTINCT_BACKUP_KEY_MIN_32__
STEX_AI_CREDENTIAL_ENCRYPTION_KEY=__CREDENTIAL_ENCRYPTION_64_HEX__
STEX_AI_CREDENTIAL_FINGERPRINT_KEY=__DISTINCT_CREDENTIAL_FINGERPRINT_64_HEX__
