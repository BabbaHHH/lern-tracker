# New transport, not an existing provider/account. STARTTLS is mandatory on 587.
STEX_SMTP_HOST=__SMTP_HOST__
STEX_SMTP_PORT=587
STEX_SMTP_TLS=starttls
STEX_SMTP_USER=__SMTP_USER__
STEX_SMTP_PASSWORD=__DISTINCT_SMTP_PASSWORD_MIN_16__
STEX_SMTP_FROM_ADDRESS=__SMTP_FROM_ADDRESS__
STEX_SMTP_FROM_NAME="Stex Tracker"
