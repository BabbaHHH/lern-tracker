const a=new SyntheticAccount(auth,'c5a-browser-a'),b=new SyntheticAccount(auth,'c5a-browser-b');await a.initialize();await b.initialize();await importSearchFixture(auth,a.headers());await seedPreparationFixture(auth,a,'search-synthetic-case');
const docs=new DocumentsService(auth),v=await docs.read(a.headers()),bytes=Buffer.from('Altes synthetisches Original.\n');
await docs.submit(a.headers(),{contractVersion:1,action:'documents',requestId:'c5a_fixture',expectedAccountId:a.name,expectedAccessGeneration:v.account.accessGeneration,expectedSessionContext:v.account.sessionContext,id:'c5a-existing',expectedRevision:null,operation:'upload',fields:{name:'Erhaltene Quelle',tags:['Bestand'],includeInNextPlan:false},file:{name:'Altquelle.txt',size:bytes.length,type:'text/plain',sha256:fileHash(bytes)}},bytes);
await database.transaction(async c=>{await lockState(c);await c.query("UPDATE stex.personal_records SET payload=payload||$2::jsonb,normalized=normalized-'c5aSourceVersionId' WHERE record_key=$1",[recordKey('document',a.name,'c5a-existing'),JSON.stringify({textContent:'Alte Textquelle bleibt versioniert erhalten.',summary:'Alte Zusammenfassung.',unknownPrivate:{keep:'C5a ORIGINAL'}})]);});
const writing=new WritingService(auth),w=await writing.read(a.headers());await writing.submit(a.headers(),{contractVersion:1,action:'writing',requestId:'c4a_c5a_fixture',expectedAccountId:a.name,expectedAccessGeneration:w.account.accessGeneration,expectedSessionContext:w.account.sessionContext,kind:'draft',id:'c5a-existing-draft',expectedRevision:null,operation:'save',fields:{title:'Erhaltener Schreibentwurf',area:'zr',type:'Urteil',klausurId:'search-synthetic-case',contentHtml:'<p>Vorhandener Text</p>',contentText:'Vorhandener Text'}});
await database.transaction(async c=>{await lockState(c);await c.query("INSERT INTO stex.record_references(source_key,path,owner_user_id,source_personal_key,target_personal_key) VALUES($1,'value.syntheticDocument',$2,$1,$3)",[recordKey('draft',a.name,'c5a-existing-draft'),a.name,recordKey('document',a.name,'c5a-existing')]);});
await writeFile(join(root,'Original-eins.txt'),'C5a bewusst hochgeladenes Original eins.\n');await writeFile(join(root,'Original-zwei.txt'),'C5a bewusst hochgeladenes Original zwei.\n');
const metadata={root,port,webPort,baseURL,snapshot,accounts:[a.name,b.name]};await writeFile(resolve('docs/entwuerfe/DATA-01/pruefungen/data-c5a-browser-runtime.json'),JSON.stringify(metadata,null,2)+'\n');console.log(JSON.stringify(metadata));
const next=spawn(process.execPath,['--import','tsx','--import',resolve('scripts/data-migration/c5a-network-guard.mts'),join(snapshot,'node_modules/next/dist/bin/next'),'dev','--webpack','--hostname','127.0.0.1','--port',String(webPort)],{cwd:snapshot,env:{...process.env,NEXT_TELEMETRY_DISABLED:'1',STEX_AUTH_MODE:'local',STEX_LEARNING_MODE:'account',STEX_ISOLATED_DEV:'1',BETTER_AUTH_URL:baseURL,STEX_LOCAL_DATA_DIR:root,STEX_LOCAL_POSTGRES_PORT:String(port)},stdio:['ignore','inherit','inherit']});
let stopping=false;async function stop(){if(stopping)return;stopping=true;if(next.exitCode===null){next.kill('SIGTERM');await new Promise<void>(r=>next.once('exit',()=>r()));}await database.close();await cluster.stop();await rm(root,{recursive:true,force:true});process.exit(0);}
createInterface({input:process.stdin}).on('line',line=>{if(line==='stop')void stop();});process.on('SIGTERM',()=>void stop());process.on('SIGINT',()=>void stop());
