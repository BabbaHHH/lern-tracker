# Private local development only. Never put real keys into a shared download.
OPENROUTER_API_KEY=
OPENROUTER_API_KEY_STRONG=
OPENROUTER_API_KEY_CHEAP=
OPENROUTER_API_KEY_TEST=
# Optional provider model IDs; defaults are in src/lib/ai.ts.
OPENROUTER_MODEL_CHEAP=deepseek/deepseek-v4-flash-0731
OPENROUTER_MODEL_STRONG=openai/gpt-6-luna
OPENROUTER_MODEL_PREMIUM=anthropic/claude-opus-5.5
# Absolute path to your private PDFs, outside public/.
PDF_BASE_PATH=
# Optional trusted LAN origins, exact scheme + host + port, comma separated.
# LOCAL_ALLOWED_ORIGINS=http://192.168.1.10:3000
# Run with STEX_DEV_HOST=0.0.0.0 only on a trusted private network.
# Production API access remains locked until a separate production activation review.

# DATA-B operator setup. Original bytes must stay outside public/.
# These scripts read explicit process environment; they do not load .env.local.
# Leave DATABASE_URL empty to use the separate local runtime (npm run db:local).
DATABASE_URL=
STEX_PRIVATE_FILE_ROOT=
STEX_LOCAL_POSTGRES_PORT=55432
# Optional absolute folder for a separate local instance/empty restore target.
STEX_LOCAL_DATA_DIR=

# AUTH-A is local only; no external mail or production activation.
# Run npm run auth:init once. Private keys stay in db/.local, never here.
STEX_AUTH_MODE=
BETTER_AUTH_URL=http://localhost:3001
BETTER_AUTH_SECRET=
STEX_AUTH_BACKUP_KEY=
# Separate secrets for encrypted personal OpenRouter keys and duplicate detection.
# Generate two unrelated 32-byte hex values. Never put these in backups or exports.
STEX_AI_CREDENTIAL_ENCRYPTION_KEY=
STEX_AI_CREDENTIAL_FINGERPRINT_KEY=
# DATA-C1: explicit account progress in a separate synthetic local test instance.
# Empty keeps the existing browser application. Never imports browser data.
STEX_LEARNING_MODE=
