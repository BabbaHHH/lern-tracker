{
  "name": "lern-tracker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "dev:plain": "next dev --hostname 127.0.0.1",
    "dev:clean": "bash scripts/dev.sh --clean",
    "dev:webpack": "bash scripts/dev.sh --webpack",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:documents": "node --import tsx scripts/check-planning-documents.mts",
    "test:persistence": "node --import tsx --test --test-reporter=spec tests/postgres-persistence.test.ts",
    "db:local": "node --import tsx scripts/data-migration/postgres-local.mts",
    "db:migrate": "node --import tsx scripts/data-migration/persistence.mts migrate",
    "db:backup": "node --import tsx scripts/data-migration/persistence.mts backup",
    "db:restore": "node --import tsx scripts/data-migration/persistence.mts restore",
    "check": "npm run lint && npm run typecheck && npm test",
    "build:turbo": "next build",
    "auth:init": "node --import tsx scripts/auth/operator.mts init",
    "auth:operator": "node --import tsx scripts/auth/operator.mts",
    "dev:auth": "STEX_AUTH_MODE=local BETTER_AUTH_URL=http://localhost:3001 STEX_ISOLATED_DEV=1 next dev --hostname 127.0.0.1 --port 3001",
    "test:auth": "node --import tsx --test --test-reporter=spec tests/auth-postgres.test.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@tiptap/extension-character-count": "^3.24.0",
    "@tiptap/extension-text-align": "^3.24.0",
    "@tiptap/extension-underline": "^3.24.0",
    "@tiptap/pm": "^3.24.0",
    "@tiptap/react": "^3.24.0",
    "@tiptap/starter-kit": "^3.24.0",
    "better-auth": "1.7.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^1.7.0",
    "mammoth": "^1.13.0",
    "next": "^16.4.0",
    "nodemailer": "10.1.2",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "5.4.296",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "^9",
    "eslint-config-next": "^16.4.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
